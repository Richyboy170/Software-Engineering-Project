# QuickOrder Server Environment Variables
# Copy to .env locally. Never commit .env with real credentials.

# Container and listening port
PORT=3000

# Runtime environment (development | production)
NODE_ENV=development

# PostgreSQL connection string
# Local: postgresql://quickorder:devpassword@localhost:5432/quickorder
# Cloud SQL: postgresql://USER:PASS@localhost/quickorder?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL="postgresql://quickorder:devpassword@localhost:5432/quickorder"

# Allowed web frontend origin
CORS_ORIGIN=http://localhost:5173

# Secret token signing key
SESSION_SECRET=quickorder-dev-secret-key-replace-in-cloud
