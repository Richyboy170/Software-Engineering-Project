# QuickOrder Server Environment Variables
# Copy to .env locally. Never commit .env with real credentials.
# Placeholder values only.

# Container and listening port (read by src/index.ts)
PORT=3000

# Runtime environment: development | test | production
# (read by src/index.ts, src/db.ts, src/persistence/runtime.ts, prisma/seed.ts)
NODE_ENV=development

# PostgreSQL connection string (read by Prisma via prisma/schema.prisma)
# Local: postgresql://quickorder:devpassword@localhost:5432/quickorder
# Cloud SQL: postgresql://USER:PASS@localhost/quickorder?host=/cloudsql/PROJECT:REGION:INSTANCE
# In GCP this comes from Secret Manager: quickorder-database-url
DATABASE_URL="postgresql://quickorder:devpassword@localhost:5432/quickorder"

# Password for seeded demo users (read by prisma/seed.ts)
# Required when NODE_ENV=production; falls back to a dev default otherwise.
# In GCP this comes from Secret Manager: quickorder-demo-password
DEMO_USER_PASSWORD=replace-with-demo-password

# In production, demo users are seeded only when this is true (prisma/seed.ts).
# Set by deploy/deploy.sh (true with --demo, otherwise false).
SEED_DEMO_DATA=false

# Container timezone (read by the Node.js runtime, not by app code)
TZ=Asia/Bangkok
